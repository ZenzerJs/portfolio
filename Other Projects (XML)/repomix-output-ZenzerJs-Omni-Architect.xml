def _normalize_env_secret(value: str) -> str:
    v = (value or "").strip()
    if len(v) >= 2 and ((v[0] == "(" and v[-1] == ")") or (v[0] == v[-1] and v[0] in ("'", '"'))):
        v = v[1:-1].strip()
    return v


