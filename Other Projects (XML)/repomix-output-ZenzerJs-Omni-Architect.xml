            ("z-score", 3), ("confidence interval", 3), ("hypothesis test", 4),
            ("null hypothesis", 4), ("p-value", 4), ("significance level", 3),
            ("bayes", 4), ("conditional probability", 4), ("independence", 2),
            ("law of large numbers", 4), ("central limit theorem", 4),
