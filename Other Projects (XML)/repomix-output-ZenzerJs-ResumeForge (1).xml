          <Skeleton className="h-40 w-full rounded-lg" />
          <Skeleton className="h-40 w-full rounded-lg" />
        </div>
      </div>
    </ShellFrame>
  );
}

export function PageSkeleton({ variant = "default", className }: PageSkeletonProps) {
  const body = (() => {
    switch (variant) {
      case "editor":
        return <EditorWorkspaceSkeleton />;
      case "tailor":
        return <TailorSkeleton />;
      case "library":
