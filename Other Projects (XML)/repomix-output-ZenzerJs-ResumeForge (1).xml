              roleAffinity: ["Backend"],
            },
          ],
        },
      ],
      skippedSections: ["Contact"],
    };

    vi.spyOn(global, "fetch").mockResolvedValueOnce(
      new Response(
        JSON.stringify({
          choices: [{ message: { content: JSON.stringify(extractPayload) } }],
        }),
        { status: 200, headers: { "Content-Type": "application/json" } }
