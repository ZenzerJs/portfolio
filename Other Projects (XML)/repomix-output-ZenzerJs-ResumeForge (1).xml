    region: "QC",
    lat: 45.5017,
    lng: -73.5673,
    aliases: ["montreal", "montréal", "laval", "longueuil", "westmount"],
  },
  ottawa: {
    key: "ottawa",
    name: "Ottawa",
    region: "ON",
    lat: 45.4215,
    lng: -75.6972,
    aliases: ["ottawa", "gatineau", "kanata", "nepean"],
  },
  calgary: {
