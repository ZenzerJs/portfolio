  it("sanitizeTypstSource reorders sections via reorderTypstSections", () => {
    const dirty = `#section("Skills")
x
#section("Experience")
y
#section("Education")
z
#section("Projects")
p
`;
    const clean = sanitizeTypstSource(dirty);
    expect(clean.indexOf('#section("Experience")')).toBeLessThan(
