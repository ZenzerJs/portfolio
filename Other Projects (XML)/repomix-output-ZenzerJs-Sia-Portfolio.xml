              <span className="sr-only">Testimonial </span>
              {String(index + 1).padStart(2, '0')} / {String(TESTIMONIALS.length).padStart(2, '0')}
            </span>

            <div className="flex items-center gap-1.5">
              <button
                type="button"
                onClick={() => paginate(-1)}
