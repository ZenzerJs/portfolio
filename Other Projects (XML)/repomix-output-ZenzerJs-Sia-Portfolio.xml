    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    max-width: 900px;
}

.work-intro__heading {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 6vw, 5.5rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--text-dark);
    margin: 0;
    text-align: center;
}

.work-intro__description {
