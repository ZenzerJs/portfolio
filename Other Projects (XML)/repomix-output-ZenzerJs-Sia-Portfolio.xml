        mockupRef.current,
        { scale: 1.12, borderRadius: '0px' },
        { scale: 0.92, borderRadius: '24px', duration: 1, ease: 'power2.out' },
        0
      );
    },
    { scope: sectionRef }
  );

  return (
    <section
      ref={sectionRef}
