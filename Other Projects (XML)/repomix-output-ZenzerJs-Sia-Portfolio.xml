    box-sizing: border-box;
}

.site-header .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 0 50px;
}

.site-nav {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1.75rem;
}

.site-nav .nav-link {
    color: var(--text-dark);
    text-decoration: none;
    font-weight: 400;
    font-size: 0.95rem;
    position: relative;
    transition: color 0.2s ease-out, transform 0.2s ease-out;
}

.site-nav .nav-link::after {
    content: '';
