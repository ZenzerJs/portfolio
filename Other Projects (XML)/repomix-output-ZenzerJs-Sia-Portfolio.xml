  useGSAP(
    () => {
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: sectionRef.current,
          start: 'top top',
          end: '+=120%',
          scrub: 0.8,
          pin: true,
        },
      });

      tl.to(headlineRef.current, {
        opacity: 0,
        y: -40,
        duration: 0.4,
      })
