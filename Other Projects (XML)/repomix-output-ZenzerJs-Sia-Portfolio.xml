}

.about-education__degree {
    font-size: 15pt;
    font-weight: 300;
    color: var(--text-dark);
    opacity: 0.85;
}

.about-education__period {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-dark);
    opacity: 0.6;
}

.about-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
}

.about-skills__chip {
    border: 1px solid rgba(30, 58, 95, 0.45);
    border-radius: 50px;
    padding: 0.3rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-dark);
}

.about-resume__link {
    display: inline-block;
    border: 1px solid var(--text-dark);
    border-radius: 50px;
    padding: 0.55rem 1.5rem;
    font-size: 0.9rem;
